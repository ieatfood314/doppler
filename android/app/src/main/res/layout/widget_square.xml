<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 widget. Sizes are in the launcher's layout units: the Nothing launcher lays a 2x2 out at about
     177dp square and draws it at 158dp. Text is in the system font: a widget can't use the app's own fonts,
     and on Nothing OS the system font is Inter, the launcher's own. Widgets.kt shows "idle" (today's screen time over the 1 and 2) or "live" (cover, title
     and artist over the back, pause and skip zones, with the playing number in the corner).
     The time is drawn on the stars' own grid: 4.2dp between stars, one empty column between digits. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_square">
    <LinearLayout android:id="@+id/idle" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="4dp">
        <FrameLayout android:id="@+id/time" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="@drawable/widget_press_square" android:contentDescription="Screen time">
            <LinearLayout android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal" android:layout_marginTop="26dp"
                android:orientation="horizontal" android:baselineAligned="false" android:importantForAccessibility="no">
                <LinearLayout android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false">
                    <ImageView android:id="@+id/h1" android:layout_width="20.75dp" android:layout_height="29.15dp" android:visibility="gone"
                        android:layout_marginEnd="4.45dp" android:src="@drawable/dots_1" android:tint="@color/widget_fg" />
                    <ImageView android:id="@+id/h2" android:layout_width="20.75dp" android:layout_height="29.15dp"
                        android:src="@drawable/dots_2" android:tint="@color/widget_fg" />
                    <ImageView android:id="@+id/hletter" android:layout_width="10.37dp" android:layout_height="14.57dp" android:layout_gravity="bottom"
                        android:layout_marginStart="3.95dp" android:layout_marginEnd="9.52dp"
                        android:src="@drawable/dots_h" android:tint="@color/widget_dim" />
                </LinearLayout>
                <ImageView android:id="@+id/m1" android:layout_width="20.75dp" android:layout_height="29.15dp"
                    android:layout_marginEnd="4.45dp" android:src="@drawable/dots_4" android:tint="@color/widget_fg" />
                <ImageView android:id="@+id/m2" android:layout_width="20.75dp" android:layout_height="29.15dp"
                    android:src="@drawable/dots_9" android:tint="@color/widget_fg" />
                <ImageView android:id="@+id/mletter" android:layout_width="10.37dp" android:layout_height="14.57dp" android:layout_gravity="bottom"
                    android:layout_marginStart="3.95dp" android:src="@drawable/dots_m" android:tint="@color/widget_dim" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/widget_press_square" android:contentDescription="Play 1">
                <ImageView android:layout_width="29.64dp" android:layout_height="41.64dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="26dp"
                    android:src="@drawable/dots_1" android:tint="@color/widget_fg" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/widget_press_square" android:contentDescription="Play 2">
                <ImageView android:layout_width="29.64dp" android:layout_height="41.64dp" android:layout_gravity="bottom|center_horizontal" android:layout_marginBottom="26dp"
                    android:src="@drawable/dots_2" android:tint="@color/widget_fg" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/live" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <!-- 10dp under the artist: its descenders then sit as far from the bottom as the cover does from the top. -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
            android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
            <ImageView android:id="@+id/cover" android:layout_width="84dp" android:layout_height="84dp"
                android:scaleType="centerCrop" android:src="@drawable/widget_cover" android:importantForAccessibility="no" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="8dp" android:gravity="bottom|start"
                android:textSize="19sp" android:textColor="@color/widget_fg"
                android:maxLines="5" android:ellipsize="end" android:lineSpacingMultiplier="0.95" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="19sp"
                android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="19dp"
                android:layout_marginTop="2dp" android:gravity="top|start"
                android:textSize="13sp" android:textColor="@color/widget_dim"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="10sp" android:autoSizeMaxTextSize="13sp"
                android:autoSizeStepGranularity="0.5sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal"
            android:padding="4dp">
            <FrameLayout android:id="@+id/prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:background="@drawable/widget_press_square" android:contentDescription="Back" />
            <FrameLayout android:id="@+id/pause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4"
                android:background="@drawable/widget_press_square" android:contentDescription="Pause" />
            <FrameLayout android:id="@+id/next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:background="@drawable/widget_press_square" android:contentDescription="Skip" />
        </LinearLayout>
        <FrameLayout android:id="@+id/open" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end"
            android:layout_margin="4dp" android:background="@drawable/widget_press_square" android:contentDescription="Open playlist">
            <ImageView android:id="@+id/lit" android:layout_width="10.87dp" android:layout_height="15.27dp" android:layout_gravity="top|end"
                android:layout_marginTop="10dp" android:layout_marginEnd="10dp"
                android:src="@drawable/dots_1" android:tint="@color/nothing_red" android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
