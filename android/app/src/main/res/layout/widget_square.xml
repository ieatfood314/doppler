<?xml version="1.0" encoding="utf-8"?>
<!-- The 2x2 widget. Widgets.kt shows "idle" (today's screen time over the 1 and 2) or "live" (cover, title
     and artist over the back, pause and skip zones, with the playing number in the corner).
     The time is drawn on the stars' own grid: 3.4dp between stars, one empty column between digits. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg">
    <LinearLayout android:id="@+id/idle" android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="4dp">
        <FrameLayout android:id="@+id/time" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:background="@drawable/widget_press" android:contentDescription="Screen time">
            <LinearLayout android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center"
                android:orientation="horizontal" android:baselineAligned="false" android:importantForAccessibility="no">
                <LinearLayout android:id="@+id/hours" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:baselineAligned="false">
                    <ImageView android:id="@+id/h1" android:layout_width="15.84dp" android:layout_height="22.64dp"
                        android:layout_marginEnd="4.56dp" android:src="@drawable/dots_1" android:tint="@color/widget_fg" />
                    <ImageView android:id="@+id/h2" android:layout_width="15.84dp" android:layout_height="22.64dp"
                        android:src="@drawable/dots_2" android:tint="@color/widget_fg" />
                    <ImageView android:id="@+id/hletter" android:layout_width="7.92dp" android:layout_height="11.32dp" android:layout_gravity="bottom"
                        android:layout_marginStart="3.9dp" android:layout_marginEnd="8.4dp"
                        android:src="@drawable/dots_h" android:tint="@color/widget_dim" />
                </LinearLayout>
                <ImageView android:id="@+id/m1" android:layout_width="15.84dp" android:layout_height="22.64dp"
                    android:layout_marginEnd="4.56dp" android:src="@drawable/dots_4" android:tint="@color/widget_fg" />
                <ImageView android:id="@+id/m2" android:layout_width="15.84dp" android:layout_height="22.64dp"
                    android:src="@drawable/dots_9" android:tint="@color/widget_fg" />
                <ImageView android:id="@+id/mletter" android:layout_width="7.92dp" android:layout_height="11.32dp" android:layout_gravity="bottom"
                    android:layout_marginStart="3.9dp" android:src="@drawable/dots_m" android:tint="@color/widget_dim" />
            </LinearLayout>
        </FrameLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:orientation="horizontal">
            <FrameLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/widget_press" android:contentDescription="Play 1">
                <ImageView android:layout_width="23.3dp" android:layout_height="33.3dp" android:layout_gravity="center"
                    android:src="@drawable/dots_1" android:tint="@color/widget_fg" android:importantForAccessibility="no" />
            </FrameLayout>
            <FrameLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
                android:background="@drawable/widget_press" android:contentDescription="Play 2">
                <ImageView android:layout_width="23.3dp" android:layout_height="33.3dp" android:layout_gravity="center"
                    android:src="@drawable/dots_2" android:tint="@color/widget_fg" android:importantForAccessibility="no" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
    <FrameLayout android:id="@+id/live" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp">
            <ImageView android:id="@+id/cover" android:layout_width="72dp" android:layout_height="72dp"
                android:scaleType="centerCrop" android:src="@drawable/widget_cover" android:importantForAccessibility="no" />
            <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:layout_marginTop="8dp" android:gravity="bottom|start"
                android:textSize="17sp" android:textColor="@color/widget_fg" android:fontFamily="@font/space_grotesk"
                android:maxLines="5" android:ellipsize="end" android:lineSpacingMultiplier="0.95" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="17sp"
                android:autoSizeStepGranularity="1sp" />
            <TextView android:id="@+id/artist" android:layout_width="match_parent" android:layout_height="17dp"
                android:layout_marginTop="2dp" android:gravity="bottom|start"
                android:textSize="12sp" android:textColor="@color/widget_dim" android:fontFamily="@font/space_grotesk"
                android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false"
                android:autoSizeTextType="uniform" android:autoSizeMinTextSize="9sp" android:autoSizeMaxTextSize="12sp"
                android:autoSizeStepGranularity="0.5sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal">
            <FrameLayout android:id="@+id/prev" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:background="@drawable/widget_press" android:contentDescription="Back" />
            <FrameLayout android:id="@+id/pause" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="4"
                android:background="@drawable/widget_press" android:contentDescription="Pause" />
            <FrameLayout android:id="@+id/next" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="3"
                android:background="@drawable/widget_press" android:contentDescription="Skip" />
        </LinearLayout>
        <FrameLayout android:id="@+id/open" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end"
            android:background="@drawable/widget_press" android:contentDescription="Open playlist">
            <ImageView android:id="@+id/lit" android:layout_width="9.32dp" android:layout_height="13.32dp" android:layout_gravity="top|end"
                android:layout_marginTop="14dp" android:layout_marginEnd="14dp"
                android:src="@drawable/dots_1" android:tint="@color/nothing_red" android:importantForAccessibility="no" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
